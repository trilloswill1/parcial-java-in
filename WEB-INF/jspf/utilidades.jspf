<%@ page pageEncoding="UTF-8" %>
<%@ page import="java.security.MessageDigest" %>
<%@ page import="java.security.SecureRandom" %>
<%@ page import="java.util.Base64" %>
<%!
/**
 * Genera un salt aleatorio seguro de 32 bytes, codificado en Base64.
 * Cada llamada produce un valor distinto gracias a SecureRandom.
 * @return String Salt en formato Base64 (44 caracteres aprox.)
 */
public String generarSalt() {
    try {
        byte[] saltBytes = new byte[32];
        SecureRandom sr = new SecureRandom();
        sr.nextBytes(saltBytes);
        return Base64.getEncoder().encodeToString(saltBytes);
    } catch (Exception ex) {
        throw new RuntimeException("Error al generar salt", ex);
    }
}

/**
 * Aplica SHA-256 sobre la concatenación password + salt.
 * El salt se concatena directamente al final del password (sin separador).
 * Retorna el hash en formato hexadecimal de 64 caracteres.
 *
 * Flujo de registro:
 *   String salt  = generarSalt();
 *   String hash  = claveCifrada(password, salt);
 *   // guardar (correo, hash, salt) en la tabla usuario
 *
 * Flujo de login:
 *   SELECT password_hash, password_salt FROM usuario WHERE correo = ?;
 *   String hashIngresado = claveCifrada(passwordInput, saltBD);
 *   if (hashIngresado.equals(hashBD)) { usuario autenticado }
 *
 * @param password Contraseña en texto plano ingresada por el usuario
 * @param salt     Salt único del usuario (almacenado en BD)
 * @return Hexadecimal de 64 chars con el hash SHA-256
 */
public String claveCifrada(String password, String salt) {
    try {
        MessageDigest md = MessageDigest.getInstance("SHA-256");
        // password + salt concatenados en String → mismos bytes que concatenar arrays UTF-8
        byte[] digest = md.digest((password + salt).getBytes("UTF-8"));
        StringBuilder sb = new StringBuilder();
        for (byte b : digest) {
            sb.append(String.format("%02x", b));
        }
        return sb.toString();
    } catch (Exception ex) {
        throw new RuntimeException("Error al cifrar la contraseña", ex);
    }
}

/**
 * SHA-256 simple SIN salt (método legacy).
 * Se mantiene por compatibilidad si otro código ya lo invoca.
 * Para el flujo de registro/login, usar SIEMPRE claveCifrada(password, salt).
 * @deprecated Usar claveCifrada(String password, String salt) en su lugar.
 */
public String sha256(String texto) {
    try {
        MessageDigest md = MessageDigest.getInstance("SHA-256");
        byte[] resumen = md.digest(texto.getBytes("UTF-8"));
        StringBuilder sb = new StringBuilder();
        for (byte b : resumen) sb.append(String.format("%02x", b));
        return sb.toString();
    } catch (Exception ex) {
        throw new RuntimeException("Error al cifrar texto", ex);
    }
}

/**
 * Firma legacy: claveCifrada con un solo argumento (sin salt).
 * Mantiene compatibilidad con código existente que ya lo invoque.
 * @deprecated Usar claveCifrada(String password, String salt).
 */
public String claveCifrada(String texto) {
    return sha256(texto);
}
%>